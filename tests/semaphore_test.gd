extends SceneTree
const Model = preload("res://semaphore_model.gd")
var failures := 0
func _initialize(): call_deferred("run_tests")
func run_tests():
 var m = Model.new()
 check(m.value == 1 and m.queue.is_empty(), "initial semaphore")
 check(m.p(0) and m.value == 0 and m.states[0] == "inside", "first process acquires")
 check(not m.p(0) and m.value == 0, "duplicate P rejected")
 check(m.p(1) and m.p(2) and m.value == -2 and m.queue == [1,2], "P blocks in FIFO order")
 check(not m.v(1) and m.value == -2, "blocked process cannot release")
 check(m.v(0) and m.value == -1 and m.states[1] == "ready" and m.queue == [2], "V wakes first waiter")
 check(not m.p(1) and m.value == -1, "awakened P is not performed twice")
 check(m.resume_process(1) and m.states[1] == "inside" and m.value == -1, "wake is ready before execution")
 check(m.v(1) and m.value == 0 and m.states[2] == "ready", "second waiter wakes")
 check(m.resume_process(2) and m.v(2) and m.value == 1 and m.queue.is_empty(), "resource returned")
 var app = load("res://main.tscn").instantiate()
 root.add_child(app)
 await process_frame
 app._show_chapters()
 app._open_chapter(3)
 check(app.chapter_intro.semaphore_button.visible, "chapter entry visible")
 app.chapter_intro.semaphore_requested.emit()
 check(app.semaphore_container.visible and app._has_banker_modules(), "chapter opens module combination")
 var lab = app.semaphore_lab
 lab._p()
 lab.selection.select(1)
 lab._p()
 check(lab.model.value == -1 and lab.queue_label.text.contains("P2"), "interactive blocking")
 lab.selection.select(0)
 lab._v()
 check(lab.model.states[1] == "ready" and lab.result.text.contains("就绪"), "interactive wake")
 var normal_size = lab.resource.get_theme_font_size("font_size")
 lab.present_button.pressed.emit()
 check(app.semaphore_presentation and not app.library_scroll.visible and not app.workspace_slots.visible, "presentation focuses on the signal lab")
 check(lab.resource.get_theme_font_size("font_size") > normal_size, "presentation enlarges key state")
 lab.demo_start.pressed.emit()
 check(lab.demo_actions.visible and not lab.manual.visible and lab.model.value == 1, "classroom demo starts from a free resource")
 lab.demo_next.pressed.emit()
 lab.demo_next.pressed.emit()
 check(lab.resource.text.contains("P1 正在使用") and lab.queue_label.text.contains("P2"), "P1 owns resource while P2 waits")
 lab.demo_next.pressed.emit()
 check(lab.resource.text.contains("许可已交给 P2") and lab.process_labels[1].text.contains("等待调度"), "wake hands off permit without entering")
 lab.demo_next.pressed.emit()
 check(lab.resource.text.contains("P2 正在使用") and lab.model.value == 0, "dispatch lets P2 use the resource")
 lab.demo_next.pressed.emit()
 check(lab.manual.visible and lab.model.value == 1 and lab.demo_hint.text.contains("示范完成"), "demo completes and returns to manual mode")
 app._remove_module("resource")
 check(not app.semaphore_container.visible, "incomplete combination closes lab")
 check(app.library_scroll.visible and app.workspace_slots.visible and not app.semaphore_presentation, "leaving signal lab restores workspace")
 print("Semaphore failures: ", failures)
 quit(1 if failures else 0)
func check(condition: bool, name: String):
 if not condition:
  failures += 1
  push_error("FAILED: " + name)
