extends SceneTree
var failures := 0
func _initialize():
 call_deferred("run_tests")
func run_tests():
 var app = load("res://main.tscn").instantiate()
 root.add_child(app)
 await process_frame
 check(app.home_screen.visible and not app.workspace_screen.visible, "home is initial screen")
 app._begin_explore()
 check(not app.home_screen.visible and app.workspace_screen.visible, "open workspace")
 check(not app._has_modules() and not app.experiment.visible and app.empty_hint.visible, "empty workspace")
 app._next_step()
 check(app.steps.is_empty(), "incomplete combination cannot run")
 var program = app.module_slots["program"]
 check(not program._can_drop_data(Vector2.ZERO, {"kind":"module", "id":"os"}), "reject wrong module")
 check(program._can_drop_data(Vector2.ZERO, {"kind":"module", "id":"program"}), "accept matching module")
 program._drop_data(Vector2.ZERO, {"kind":"module", "id":"program"})
 check(app.module_state.program and not app._has_modules(), "drag adds one module")
 check(not app.module_buttons.program.visible, "selected module leaves library")
 check(app.module_slots.program.visible and not app.module_slots.cpu.visible, "workspace shows only selected modules")
 app._add_module("os")
 app._add_module("memory")
 check(app._has_modules() and app.topic_panel.visible and not app.experiment.visible, "combination opens topic selection")
 app._start_experiment()
 check(app.experiment.visible and not app.topic_panel.visible, "topic opens experiment")
 app._back_to_topics()
 check(app.topic_panel.visible and not app.experiment.visible, "return to topics")
 app._start_experiment()
 app._remove_module("os")
 check(not app.experiment.visible, "removing module hides experiment")
 check(app.module_buttons.os.visible, "removed module returns to library")
 check(not app.module_slots.os.visible, "removed module leaves workspace")
 app._add_module("os")
 app._start_experiment()
 app._toggle_settings()
 check(app.settings_panel.visible, "settings expand")
 app._toggle_settings()
 check(not app.settings_panel.visible, "settings collapse")
 app._toggle_comparison()
 check(app.comparison_panel.visible, "comparison expand")
 app._toggle_comparison()
 check(not app.comparison_panel.visible, "comparison collapse")
 check(app._choose(0, 1800) == 2, "first fit")
 check(app._choose(1, 1800) == 4, "best fit")
 check(app._choose(2, 1800) == 2, "worst fit")
 for algo in 3:
  app._on_preset(0)
  app.mode.select(algo)
  app._refresh()
  var selected = 4 if algo == 1 else 2
  check(app.view.candidate_index == selected, "automatic partition preview")
  app._allocate_now()
  check(not app.segments[selected].free and app.segments[selected].size == 1800, "direct allocation for selected algorithm")
 app._on_preset(0)
 app.mode.select(1)
 app._prepare()
 check(app.steps.size() == 2, "best fit checks small block first")
 app._next_step()
 app._next_step()
 app._next_step()
 check(not app.segments[4].free and app.segments[4].size == 1800, "allocation")
 check(app.segments[5].free and app.segments[5].size == 200, "remaining")
 app._release(4)
 check(app.segments[4].free and app.segments[4].size == 2000, "coalesce")
 app.size_input.text = "900"
 app._on_size_changed("900")
 app._prepare()
 check(app.steps.is_empty(), "impossible allocation")
 app.layout_input.text = "10, -2, 20"
 app._reset()
 app._release(1)
 check(app.segments.size() == 1 and app.segments[0].size == 320, "coalesce both sides")
 app._on_preset(1)
 check(app._choose(0, 2000) == -1, "fragmentation cannot allocate")
 var before_failure=app.segments.duplicate(true)
 app._allocate_now()
 check(app.segments==before_failure and app.phase.text=="分配失败", "immediate failure preserves memory")
 app._compact()
 check(app.segments.back().free and app.segments.back().size == 2400, "compaction coalesces free space")
 check(app._choose(0, 2000) >= 0, "allocation after compaction")
 app._on_preset(2)
 app.mode.select(1)
 app._refresh()
 check(app.view.candidate_index==2, "chosen algorithm previews matching partition")
 app._allocate_now()
 check(not app.segments[2].free and app.segments[2].size==1800, "immediate allocation uses algorithm")
 app._on_preset(3)
 app._release(1)
 check(app.segments[0].size == 2400, "preset release joins adjacent free blocks")
 app._on_preset(4)
 check(app._unit()=="KB" and app._fmt(app.segments[2].size)=="0.1", "classroom decimal fragment")
 check(app._fmt(app.segments[4].start)=="37" and app._choose(0,40)==4, "classroom first fit selects 83 KB")
 check(app._to_tenths("9.9")==99 and app._to_tenths("0.1")==1 and app._to_tenths("9.99")==-2147483648, "decimal precision")
 check(app.view.candidate_index==4, "small fragment is skipped automatically")
 app._next_step()
 app._next_step()
 app._next_step()
 check(app._fmt(app.segments[4].size)=="4" and app._fmt(app.segments[5].size)=="79", "decimal classroom allocation")
 app.layout_input.text = "10, 0"
 app._reset()
 check(app.segments.is_empty(), "invalid layout")
 app._clear_modules()
 check(not app._has_modules() and app.empty_hint.visible, "clear combination")
 app._add_example()
 check(app._has_modules() and app.topic_panel.visible, "one-click example")
 app._show_home()
 check(app.home_screen.visible and not app.workspace_screen.visible, "return home")
 app._start_from_home()
 check(app.workspace_screen.visible and app.experiment.visible, "direct example")
 check(not app.segments.is_empty() and app.size_input.text == "180" and app.mode.selected == 0, "direct example resets defaults")
 app._show_home()
 app._begin_explore()
 check(app.topic_panel.visible and not app.experiment.visible, "explore returns to topic selection")
 app._show_chapters()
 check(app.chapter_screen.visible and not app.home_screen.visible, "chapter list")
 for chapter in [1, 2, 3, 8, 9]:
  app._open_chapter(chapter)
  var count = {1:5, 2:4, 3:5, 8:3, 9:3}[chapter]
  check(app.chapter_intro.topic_choice.item_count == count, "chapter topic count")
  for topic_index in count:
   app.chapter_intro._select_topic(topic_index)
   check(app.chapter_intro.step == 0 and app.chapter_intro.quiz_box.visible, "topic resets and has exercise")
   var correct = app.chapter_intro.MATERIAL.CONTENT[chapter][topic_index].answer
   app.chapter_intro._check_answer((correct + 1) % 3)
   check(app.chapter_intro.quiz_feedback.text.begins_with("再想一想"), "incorrect answer explained")
   app.chapter_intro._check_answer(correct)
   check(app.chapter_intro.quiz_feedback.text.begins_with("回答正确"), "correct answer explained")
   app.chapter_intro.next.pressed.emit()
   check(app.chapter_intro.step == 1, "each topic advances")
  app._show_chapters()
 for chapter in [1, 2, 3, 8, 9]:
  app._open_chapter(chapter)
  check(app.chapter_intro.visible and not app.chapter_screen.visible, "chapter intro opens")
  check(app.chapter_intro.step == 0, "chapter begins at first step")
  app.chapter_intro.next.pressed.emit()
  check(app.chapter_intro.step == 1, "chapter intro advances")
  app._show_chapters()
 app._open_chapter(4)
 check(app.schedule_container.visible and app._has_scheduler_modules(), "chapter 4 navigation")
 app._show_chapters()
 app._open_chapter(5)
 check(app.banker_container.visible and app._has_banker_modules(), "chapter 5 navigation")
 var back_to_chapters: Button
 for candidate in app.workspace_screen.find_children("*", "Button", true, false):
  if candidate.text == "← 返回章节":
   back_to_chapters = candidate
   break
 check(is_instance_valid(back_to_chapters) and back_to_chapters.is_visible_in_tree(), "workspace exposes a return to chapters")
 if is_instance_valid(back_to_chapters): back_to_chapters.pressed.emit()
 check(app.chapter_screen.visible and not app.workspace_screen.visible and not app.home_screen.visible, "experiment returns directly to the chapter list")
 app._open_chapter(6)
 check(app.topic_panel.visible and app._has_modules(), "chapter 6 navigation")
 app._home_schedule()
 check(app.schedule_container.visible, "home scheduling shortcut")
 app._home_banker()
 check(app.banker_container.visible, "home banker shortcut")
 app._home_replacement()
 check(app.replacement_container.visible, "home replacement shortcut")
 print("Memory lab failures: ", failures)
 quit(1 if failures else 0)
func check(condition: bool, name: String):
 if not condition:
  push_error("FAILED: " + name)
  failures += 1
