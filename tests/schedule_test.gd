extends SceneTree
var failures := 0
const Schedule = preload("res://schedule_model.gd")
func _initialize(): call_deferred("run_tests")
func run_tests():
 var a = Schedule.run("0,1,2,3,4","3,6,1,4,2",1)
 check(a.ok and ids(a.events)==["P1","P3","P5","P4","P2"], "classroom SJF order")
 check(a.results[1].start == 3 and a.results[4].end == 16, "nonpreemptive start/end")
 check(a.results[4].turnaround == 15 and is_equal_approx(a.results[4].weighted,2.5), "turnaround and weighted")
 var f=Schedule.run("3,0,0","1,3,2",0)
 check(f.ok and ids(f.events)==["P2","P3","P1"], "FCFS arrival and stable ties")
 var h=Schedule.run("0,1,2,3,4","3,6,1,4,2",2)
 check(h.ok and ids(h.events)==["P1","P3","P2","P5","P4"], "HRRN selection")
 var i=Schedule.run("3,9","2,1",0)
 check(i.ok and i.events.size()==4 and i.events[0].kind=="idle" and i.events[2].kind=="idle", "idle intervals")
 check(not Schedule.run("0,1","0,3",0).ok, "zero burst rejected")
 check(not Schedule.run("0","1,2",0).ok, "mismatched inputs rejected")
 check(not Schedule.run("-1","2",0).ok, "negative arrival rejected")
 var s=Schedule.run("0,1,2","5,3,1",3)
 check(s.ok and ids(s.events)==["P1","P2","P3","P2","P1"], "SRTF preempts when shorter jobs arrive")
 check(s.results[0].id=="P3" and s.results[0].end==3 and s.results.back().end==9, "SRTF completion times")
 var rr=Schedule.run("0,1,2","5,3,1",4,2)
 check(rr.ok and ids(rr.events)==["P1","P2","P3","P1","P2","P1"], "RR admits boundary arrivals before requeue")
 check(rr.results[0].id=="P3" and rr.results[0].end==5 and rr.results.back().end==9, "RR completion times")
 check(not Schedule.run("0","3",4,0).ok, "zero time slice rejected")
 var tie=Schedule.run("0,1","2,1",3)
 check(tie.ok and ids(tie.events)==["P1","P1","P2"] and tie.results[0].end==2, "SRTF keeps running process on equal remaining time")
 var app=load("res://main.tscn").instantiate()
 root.add_child(app)
 await process_frame
 app._begin_explore()
 app._add_module("process")
 app._add_module("os")
 app._add_module("cpu")
 check(app._has_scheduler_modules() and app.topic_panel.visible and app.schedule_topic.visible, "scheduler module combination")
 check(not app.allocation_topic.visible and not app.paging_topic.visible, "memory topics require memory modules")
 app._start_schedule()
 check(app.schedule_container.visible and not app.experiment.visible, "open scheduler")
 app.schedule_lab.algorithms.select(1)
 app.schedule_lab._changed("")
 app.schedule_lab._next()
 app.schedule_lab._next()
 check(app.schedule_lab.candidates.text.contains("P2（运行 6）") and app.schedule_lab.candidates.text.contains("▶ P3（运行 1）"), "SJF explains candidate comparison")
 for k in app.schedule_lab.data.events.size(): app.schedule_lab._next()
 check(app.schedule_lab.metrics.text.contains("平均周转时间"), "scheduler walkthrough displays metrics")
 app.schedule_lab._toggle_details()
 check(app.schedule_lab.result_details.visible and app.schedule_lab.result_details.text.contains("P2   完成 16   周转 15"), "per-process metrics")
 app.schedule_lab.algorithms.select(2)
 app.schedule_lab._changed("")
 app.schedule_lab._next()
 app.schedule_lab._next()
 check(app.schedule_lab.candidates.text.contains("P2（响应比 1.33）") and app.schedule_lab.candidates.text.contains("▶ P3（响应比 2.00）"), "HRRN explains response ratios")
 app._remove_module("cpu")
 check(not app.schedule_container.visible, "removing cpu closes scheduler")
 print("Scheduler failures: ", failures)
 quit(1 if failures else 0)
func ids(events):
 var out=[]
 for event in events:
  if event.kind=="run": out.append(event.id)
 return out
func check(condition: bool, name: String):
 if not condition:
  push_error("FAILED: " + name)
  failures += 1
